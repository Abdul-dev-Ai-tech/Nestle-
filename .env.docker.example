# Copy to .env.docker (never commit it). Used by docker-compose.yml.
ENV=development                   # development (local Docker test over http) | staging | production
SITE_ADDRESS=:80                  # a real domain (e.g. compliance.example.com) enables automatic HTTPS
PUBLIC_URL=http://localhost       # https://compliance.example.com in staging/production
COOKIE_SECURE=false               # MUST be true whenever PUBLIC_URL is https (required for staging/production)

POSTGRES_DB=nec
POSTGRES_USER=nec_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
SECRET_KEY=CHANGE_ME_48_RANDOM_CHARACTERS_MINIMUM
CAMERA_CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY

AI_MODE=disabled                  # yolo once backend/models/ppe.pt exists; simulation is refused in production
DOOR_MODE=simulation
HARDWARE_DOORS_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SENTRY_DSN=
