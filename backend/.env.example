# Copy to backend/.env and fill in. NEVER commit .env. All values below are placeholders.

ENV=development                 # development | staging | production
LOG_LEVEL=INFO

# 32+ random characters. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://nec_user:CHANGE_ME@localhost:5432/nec

# Browser origin(s) allowed to call the API, comma-separated. In development the Vite proxy makes this same-origin.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cookies: must be true behind HTTPS (staging/production refuse to start otherwise)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=false       # true only behind your own reverse proxy

# Sessions and login protection
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RESET_TOKEN_TTL_MINUTES=30
# Development only: show the reset link on screen when no mail server is configured
DEV_RETURN_RESET_LINK=true

# Mail server for password-reset e-mails. Without it NO e-mail is sent (development shows the link on screen).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com, SMTP_FROM=you@gmail.com and
#   SMTP_PASSWORD = a 16-character App Password (Google Account > Security > 2-Step Verification > App passwords),
#   written without spaces. Your normal Gmail password will be rejected.
# Outlook / Microsoft 365: smtp.office365.com, port 587.  Port 465 servers are detected automatically (SSL).
# Test:  python -m app.services.mailer --test you@company.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# File storage (evidence images, employee photos)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5
EVIDENCE_RETENTION_DAYS=365

# Key that encrypts camera usernames/passwords in the database.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_CREDENTIALS_KEY=

# AI: simulation (development only) | yolo (trained weights required) | disabled
AI_MODE=simulation
YOLO_WEIGHTS=./models/ppe.pt
AI_DEFAULT_CONFIDENCE=0.60
AI_DEVICE=cpu

# Doors: simulation is the safe default. Hardware needs BOTH settings plus an in-app approval per door.
DOOR_MODE=simulation
HARDWARE_DOORS_ENABLED=false

# Optional error monitoring (pip install sentry-sdk)
SENTRY_DSN=

# Used only by `python -m app.db.seed` for the demo accounts (development). Leave empty for a random one.
SEED_PASSWORD=
